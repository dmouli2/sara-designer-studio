# Supabase project (Settings -> API), used server-side only
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte random string used to sign session cookies: openssl rand -base64 32
SESSION_SECRET=

# Order-slip scanning (FEATURE_SCAN_ORDERS in src/lib/features.ts).
# Free API key from https://aistudio.google.com — no billing needed.
GEMINI_API_KEY=
# Optional model override; defaults to gemini-2.5-flash
GEMINI_MODEL=
